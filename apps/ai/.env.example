# Copy to apps/ai/.env (git-ignored). Mastra loads it from this directory; the
# workspace root has no .env.
#
# The Vertex provider uses Application Default
# Credentials: locally `gcloud auth application-default login`, on Cloud Run
# the service account of the `ai` service.
GOOGLE_VERTEX_PROJECT=my-gcp-project
# Gemini 3.x is only served from the `global` location; regional endpoints such as
# us-central1 stop at the 2.5 family.
GOOGLE_VERTEX_LOCATION=global
# Vertex now serves Google Search grounding only (the `discovery` role) and the
# review query embeddings. Everything else is routed through OpenRouter.
# SPECSYNC_DISCOVERY_MODEL=gemini-2.5-flash

# OpenRouter routes every role but `discovery`. Required as soon as any of them
# runs; locally in this file, in the cloud from Secret Manager. Model ids are
# the full OpenRouter path (`google/gemini-3.8-flash`).
# OPENROUTER_API_KEY=
# Models the advanced per-role selector may offer, comma separated (optional,
# defaults to the union of the models the mode table names).
# SPECSYNC_CHAT_MODELS=google/gemini-3.5-flash-lite,google/gemini-3.8-flash,google/gemini-3.1-pro-preview,anthropic/claude-sonnet-5
# Model the curator ingestion workflow extracts with. An operator setting: it
# never follows a user's mode (optional, defaults to google/gemini-3.8-flash).
# SPECSYNC_EXTRACTION_MODEL=google/gemini-3.8-flash
# The CopilotKit runtime (the AG-UI route the web app uses) reports anonymous
# usage unless disabled.
COPILOTKIT_TELEMETRY_DISABLED=true

# Firebase project whose ID tokens the gateway forwards as x-specsync-token.
# The chat routes reject a run whose token does not verify against it.
GOOGLE_CLOUD_PROJECT=my-gcp-project

# Cloud SQL connection for the Mastra-owned chat history (threads, messages).
# Without it Mastra falls back to the local LibSQL file and chat history is
# not shared between processes. The tables live in the `mastra` schema.
# SPECSYNC_MEMORY_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/specsync?sslmode=no-verify
# Cheap model that writes the sidebar titles. Runs on SpecSync's own budget and
# is never charged to the user (defaults to openai/gpt-5.6-luna).
# SPECSYNC_TITLE_MODEL=openai/gpt-5.6-luna

# Spring Boot owns the authoritative PostgreSQL catalog.
SPECSYNC_API_URL=http://127.0.0.1:8080
# Optional query embeddings: must match the model and dimensions of indexed review chunks.
# SPECSYNC_REVIEW_EMBEDDING_MODEL=gemini-embedding-001
# SPECSYNC_REVIEW_EMBEDDING_DIMENSIONS=768

# Direct graph retrieval. Use neo4j+s://<instance>.databases.neo4j.io for Aura.
# Local Bolt port: docker compose port neo4j 7687 (ports may change).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=specsync-local
NEO4J_DATABASE=neo4j
# Production values come from Secret Manager. AURA_CLIENT_ID/SECRET are Terraform-only.

# AI credits (the credit wallet the API owns; 1 credit = USD 0.01). Setting this variable is the feature
# flag: with it the service admits, meters and stops runs and serves
# /chat/credits; without it nothing is metered or blocked and /chat/credits
# answers { "enabled": false }. Use the same random value >=32 characters as
# specsync.credits.service-key in apps/api/.env.local; in the cloud Terraform
# generates it and injects it into both services (infra/.../ai-credits.tf).
# SPECSYNC_CREDITS_SERVICE_KEY=

# Optional specification ingestion worker. Use a distinct, random key >=32 characters.
# SPECSYNC_INGESTION_WORKER_KEY=
# SPECSYNC_INGESTION_SOURCE_DOMAINS=ford.com.br,toyota.com.br,nissan.com.br
# Separate graph writer configuration; never grants writes to chat graph tools.
# SPECSYNC_INGESTION_NEO4J_URI=bolt://127.0.0.1:<compose-port>
# SPECSYNC_INGESTION_NEO4J_USERNAME=neo4j
# SPECSYNC_INGESTION_NEO4J_PASSWORD=
# SPECSYNC_INGESTION_NEO4J_DATABASE=neo4j

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ai",
  "projectType": "application",
  "sourceRoot": "apps/ai/src",
  "tags": ["type:app", "scope:ai"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "mastra dev",
        "cwd": "apps/ai"
      },
      "metadata": {
        "description": "Mastra Studio + API on http://localhost:4111 (needs gcloud ADC, see apps/ai/AGENTS.md)"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/.mastra/output"],
      "options": {
        "command": "mastra build",
        "cwd": "apps/ai"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "apps/ai"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest run --config vitest.config.mts",
        "cwd": "apps/ai"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/deploy/ai.sh"
      }
    },
    "data-up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ai/data/cli.mjs up"
      }
    },
    "data-migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ai/data/cli.mjs migrate"
      }
    },
    "data-seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ai/data/cli.mjs seed"
      }
    },
    "data-project": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ai/data/cli.mjs project"
      }
    },
    "data-status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/ai/data/cli.mjs status"
      }
    },
    "data-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/data/**/*",
        "{workspaceRoot}/apps/api/data/**/*"
      ],
      "options": {
        "command": "node --test apps/ai/data/foundation.test.mjs"
      }
    },
    "data-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test apps/ai/data/integration.test.mjs"
      }
    },
    "comparison-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "target": "bootJar",
          "projects": ["api"]
        }
      ],
      "options": {
        "command": "node --test apps/ai/data/comparison.integration.test.mjs"
      }
    },
    "graph-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.graph.config.mts",
        "cwd": "apps/ai"
      }
    },
    "graph-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.smoke.config.mts",
        "cwd": "apps/ai"
      }
    }
  }
}

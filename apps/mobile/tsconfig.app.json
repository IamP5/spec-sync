{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node"]
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "src/test-setup.ts",
    "src/testing/**",
    "arch/**",
    "vitest.arch.config.ts",
    "jest.config.cts",
    "node_modules"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "uniwind-types.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

/* Dedicated TypeScript project used by the tsarch architecture tests.
   It is read directly by tsarch (no `extends` resolution), so the relevant
   options as well as `include`/`exclude` must be specified literally here.
   `paths` mirrors tsconfig.json so the design-system alias resolves. */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mobile/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/testing/**",
    "node_modules"
  ]
}

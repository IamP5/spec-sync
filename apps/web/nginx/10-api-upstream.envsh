#!/bin/sh
# Sourced by the nginx image entrypoint before the templates are rendered. Splits the
# upstream URLs set by Terraform (e.g. https://specsync-dev-api-xyz.a.run.app) into the
# pieces an nginx `upstream` block needs, so proxied requests can reuse keep-alive/TLS
# sessions to the backends.
#   API_URL -> API_SCHEME / API_HOST / API_PORT   (Spring Boot API)
#   AI_URL  -> AI_SCHEME  / AI_HOST  / AI_PORT    (Mastra AI service)
set -eu

# split_url <prefix> <url>: exports <prefix>_SCHEME, <prefix>_HOST and <prefix>_PORT.
split_url() {
  prefix="$1" url="$2"
  scheme="${url%%://*}"
  rest="${url#*://}"
  hostport="${rest%%/*}"
  host="${hostport%%:*}"
  port="${hostport##*:}"
  if [ "$port" = "$hostport" ]; then
    case "$scheme" in
      https) port=443 ;;
      *) port=80 ;;
    esac
  fi
  export "${prefix}_SCHEME=$scheme" "${prefix}_HOST=$host" "${prefix}_PORT=$port"
  echo "$(echo "$prefix" | tr '[:upper:]' '[:lower:]') upstream: ${scheme}://${host}:${port}"
}

: "${API_URL:?API_URL must be set (URL of the API Cloud Run service)}"
: "${AI_URL:?AI_URL must be set (URL of the AI Cloud Run service)}"

split_url API "$API_URL"
split_url AI "$AI_URL"

{
  "name": "specsync",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/ai",
    "apps/gateway"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "nx": "nx",
    "predev": "docker compose up -d --wait postgres neo4j",
    "dev": "nx serve web --batch=false",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "lint": "nx run-many --target=lint",
    "test:arch": "nx run web:test-arch",
    "test:scripts": "nx run scripts:test",
    "verify": "node scripts/verify.mjs",
    "verify:changed": "node scripts/verify.mjs --changed",
    "sync:agent-config": "node scripts/sync-agent-config.mjs",
    "prepare": "husky && npm run sync:agent-config"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.8.0",
    "@nx-extend/terraform": "^10.4.1",
    "@nx/angular": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/gradle": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/web": "23.2.0",
    "@schematics/angular": "~22.1.0",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nx": "23.2.0",
    "postcss": "^8.5.28",
    "prettier": "~3.6.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsarch": "^5.4.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^22.0.0",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/localize": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "@ngrx/signals": "^22.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-angular": "^22.0.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "ngx-echarts": "^22.0.0",
    "ngx-sonner": "^3.1.0",
    "rxjs": "7.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
